# Normalize line endings.
#
# Every tracked file in this repo is stored LF in git history but sits
# CRLF in the Windows working tree. Without this file, any commit made
# from a non-Windows checkout rewrites all of them and destroys
# `git blame`. `text=auto` makes the normalization explicit and
# platform-independent instead of leaving it to each machine's
# core.autocrlf setting.
#
# Commit this from Windows, then run `git add --renormalize .` there so
# git records the normalization in one deliberate commit rather than
# scattering it across unrelated changes.

* text=auto

# Source and docs: LF in the repository, native in the working tree.
*.rs      text diff=rust
*.dart    text
*.py      text diff=python
*.toml    text
*.json    text
*.yml     text
*.yaml    text
*.md      text diff=markdown
*.txt     text
*.html    text
*.css     text
*.js      text

# Assembly and linker scripts: LF, since they are consumed by toolchains
# that predate or ignore CRLF tolerance.
*.s       text eol=lf
*.S       text eol=lf
*.ld      text eol=lf
*.lds     text eol=lf

# Shell scripts must be LF or they fail to execute under bash.
*.sh      text eol=lf

# Windows scripts must be CRLF for the same reason, in reverse.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary: never touch, never diff as text.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.img     binary
*.bin     binary
*.efi     binary
*.elf     binary
*.iso     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary

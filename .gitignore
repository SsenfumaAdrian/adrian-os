# ADRIAN OS ignore policy

# Rust
target/
Cargo.lock

# Dart
.dart_tool/
.packages
build/

# Python
__pycache__/
*.pyc
.venv/
venv/

# graphify (generated codebase analysis, regenerate with `graphify update .`)
graphify-out/

# graphify itself, cloned into the tree for reference. It carries its own
# .git, so without this line git records it as an embedded repository and
# `git status` nags about it on every commit.
graphify/

# Local connection analyser output (regenerate with `python3 tools/graph/render.py`)
graph-out/

# Editors / IDEs
.vscode/
.idea/

# OS metadata
Thumbs.db
Desktop.ini

# Logs
*.log

# Temp
*.tmp
*.bak
*.swp

# ADRIAN OS ignore policy

# Rust
target/
Cargo.lock

# Dart
.dart_tool/
.packages
build/

# Python
__pycache__/
*.pyc
.venv/
venv/

# graphify (generated codebase analysis, regenerate with `graphify update .`)
graphify-out/

# Editors / IDEs
.vscode/
.idea/

# OS metadata
Thumbs.db
Desktop.ini

# Logs
*.log

# Temp
*.tmp
*.bak
*.swp
